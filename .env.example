NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_ENV=development
# Sign-in / sign-out path on the shared HRM hub.
NEXT_PUBLIC_LOGOUT_URL=/signin
NEXT_DEFAULT_ITEM_COUNT=25

# AssetManagement API base. RELATIVE by default so the same build works on
# localhost, WebDev and production — the server in front routes it. Absolute is
# supported and is then used verbatim, never appended to an origin.
NEXT_PUBLIC_ASSET_API_URL=/asset-management/api
#
# Local development points this at the shared webdev gateway instead (see
# .env.development), so no local API on :5199 is required. Both data calls and the
# AuthToken -> AssetAuthToken exchange then go cross-origin to webdev:
# NEXT_PUBLIC_ASSET_API_URL=https://webdev.tulipshrm.com:4433/asset-management/api

# Optional: absolute URL of the shared HRM hub (sign-in/out). Unset means the
# platform default: the current origin, or the dev hub on a developer machine.
# NEXT_PUBLIC_HUB_URL=https://webdev.tulipshrm.com:4433

# Local-only token-paste sign-in screen. Explicit flag; never host-sniffed.
# NEXT_PUBLIC_DEV_AUTH=true

# SERVER-side only (no NEXT_PUBLIC_): where /asset-management/api/* is proxied,
# by the next dev rewrite and by server.js under IIS. Only consulted when the base
# above is RELATIVE — an absolute base bypasses this hop entirely.
ASSET_API_PROXY_TARGET=http://localhost:5199
