NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_ENV=development
# Sign-in / sign-out path on the shared HRM hub.
NEXT_PUBLIC_LOGOUT_URL=/signin
NEXT_DEFAULT_ITEM_COUNT=25
# Module path prefix. Matches `basePath` in next.config.ts and the API proxy
# prefix in server.js — API calls resolve to `{origin}/asset-management/api/*`.
NEXT_PUBLIC_API_BASE=/asset-management
# Optional: local AssetManagement API origin for the `next dev` rewrite
# (no trailing slash). When unset, localhost talks to the webdev gateway.
# NEXT_PUBLIC_ASSET_API_URL=http://localhost:5199
