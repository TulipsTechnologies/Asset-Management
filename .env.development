NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_LOGOUT_URL=/signin
NEXT_DEFAULT_ITEM_COUNT=25
NEXT_PUBLIC_API_BASE=/asset-management
# Optional: local AssetManagement API origin for the `next dev` rewrite (no
# trailing slash). Leave unset so localhost talks to the shared webdev gateway;
# set it only when running the Asset API locally.
# NEXT_PUBLIC_ASSET_API_URL=http://localhost:5199
