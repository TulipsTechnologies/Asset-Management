NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_LOGOUT_URL=/signin
NEXT_DEFAULT_ITEM_COUNT=25

# AssetManagement API base — a RELATIVE path, exactly as the employee app
# configures every sibling API (/api, /payroll/api, /crm/api). Identical in every
# environment; the server in front resolves it (the next dev rewrite here,
# server.js under IIS). Set an absolute URL only for a cross-origin deployment.
NEXT_PUBLIC_ASSET_API_URL=/asset-management/api

# Local-only token-paste sign-in, because there is no hub cookie to inherit on a
# developer machine. An explicit flag, never inferred from the hostname.
NEXT_PUBLIC_DEV_AUTH=true

# SERVER-side only: where the dev rewrite forwards /asset-management/api/* .
# Not NEXT_PUBLIC_ — the browser never sees or needs it.
ASSET_API_PROXY_TARGET=http://localhost:5199
