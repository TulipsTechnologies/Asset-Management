NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_LOGOUT_URL=/signin
NEXT_DEFAULT_ITEM_COUNT=25

# AssetManagement API base — ABSOLUTE here, so a developer machine talks straight
# to the shared webdev gateway and needs no local API running. resolveApiBase()
# uses an absolute value verbatim and never appends it to an origin, so this is
# the whole of the change: data calls AND the AuthToken -> AssetAuthToken exchange
# (which builds its URL through buildApiUrl) both land on webdev.
#
# .env.production deliberately keeps the RELATIVE /asset-management/api, so the
# deployed build stays same-origin and server.js proxies it. Do not copy this
# value there.
NEXT_PUBLIC_ASSET_API_URL=https://webdev.tulipshrm.com:4433/asset-management/api

# Local-only token-paste sign-in, because there is no hub cookie to inherit on a
# developer machine. An explicit flag, never inferred from the hostname.
NEXT_PUBLIC_DEV_AUTH=true

# SERVER-side only: where the `next dev` rewrite forwards /asset-management/api/* .
# Not NEXT_PUBLIC_ — the browser never sees or needs it.
#
# Unset while the base above is absolute: the browser calls webdev directly, so
# nothing ever reaches the same-origin path the rewrite listens on and this hop
# does not happen. Uncomment it AND restore the relative base above to run
# against a local API instead.
# ASSET_API_PROXY_TARGET=http://localhost:5199
