# @tulipstechnologies/common is normally published to the GitHub Packages registry.
# This repo currently consumes it from a vendored tarball in the repo root
# (tulipstechnologies-common-*.tgz, refreshed by common-module's sync:tgz) so installs
# work offline without registry auth. To switch back to the registry, change the
# dependency in package.json to a semver range and export NPM_TOKEN before install.
@tulipstechnologies:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${NPM_TOKEN}
# ^ Uncomment when installing from the registry (npm errors if NPM_TOKEN is unset).

# common@1.10.25 declares peer react ^18; this app uses react 19 (same as the
# employee module, which runs the same combination in production).
legacy-peer-deps=true
