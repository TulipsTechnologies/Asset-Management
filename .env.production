NEXT_PUBLIC_NODE_ENV=production
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_LOGOUT_URL=/signin
NEXT_DEFAULT_ITEM_COUNT=25

# Same relative base as development — this is what lets one build serve
# localhost, WebDev and production without a source change.
NEXT_PUBLIC_ASSET_API_URL=/asset-management/api

# SERVER-side only: server.js proxies /asset-management/api/* here. Override per
# host (deployment config, not source): ASSET_API_PROXY_TARGET=http://host:port
ASSET_API_PROXY_TARGET=http://localhost:5199
